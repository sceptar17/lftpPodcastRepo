# Source
LFTP_RSS_URL=https://livefromthepath.org/feed/podcast/
LFTP_REPOSITORY_ROOT=.

# Providers
LFTP_TRANSCRIPTION_PROVIDER=openai
LFTP_ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-6-astra

# WordPress (application password, never a normal login password)
WORDPRESS_BASE_URL=https://livefromthepath.org
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_POST_STATUS=draft

# Safety / behavior
LFTP_CREATE_WORDPRESS_DRAFTS=false
LFTP_HTTP_TIMEOUT_SECONDS=60
